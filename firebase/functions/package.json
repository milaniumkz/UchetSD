{
  "name": "cloud-functions",
  "description": "Firebase Cloud Functions",
  "dependencies": {
    "firebase-admin": "^11.11.0",
    "firebase-functions": "^4.4.1",
    "braintree": "^3.6.0",
    "@mux/mux-node": "^7.3.3",
    "stripe": "^8.0.1",
    "axios": "1.12.0",
    "razorpay": "^2.8.4",
    "qs": "^6.7.0",
    "@onesignal/node-onesignal": "^2.0.1-beta2",
    "@langchain/core": "^0.3.19",
    "@langchain/langgraph": "^0.2.23",
    "@langchain/openai": "^0.3.14",
    "@langchain/google-genai": "^0.0.8",
    "@langchain/anthropic": "^0.1.1"
  },
  "devDependencies": {
    "eslint": "^6.8.0",
    "eslint-plugin-promise": "^4.2.1"
  },
  "scripts": {
    "lint": "./node_modules/.bin/eslint --max-warnings=0 .",
    "verify:coverage": "node scripts/verify_firestore_coverage.js",
    "backfill:tax-rates": "node scripts/backfill_company_tax_rates.js",
    "backfill:tax-rates:apply": "node scripts/backfill_company_tax_rates.js --apply",
    "serve": "firebase -P uchet-9a732 emulators:start --only functions",
    "shell": "firebase -P uchet-9a732 functions:shell",
    "start": "npm run shell",
    "logs": "firebase -P uchet-9a732 functions:log",
    "compile": "cp ../../tsconfig.template.json ./tsconfig-compile.json && tsc --project tsconfig-compile.json"
  },
  "engines": {
    "node": "20"
  },
  "private": true
}
